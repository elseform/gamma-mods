--[[
    It's Time To Stop (ITTS) - modular DXML dispatcher
    Author: elseform

    The modxml_ prefix is required by the engine's DXML loader. Feature code
    owns its patch; this shared dispatcher registers one XML callback and calls
    only modules actually present in the selected installer preset.
--]]

function on_xml_read()
    local clock = elseform_itts_clock
    local stats = elseform_itts_stats

    RegisterScriptCallback("on_xml_read", function(xml_file_name, xml_obj)
        if stats and (xml_file_name == [[ui\pda_ranking.xml]]
            or xml_file_name == [[ui\pda_ranking_16.xml]])
        then
            stats.patch_ranking(xml_obj)
        elseif clock and (xml_file_name == [[ui\zone_map.xml]]
            or xml_file_name == [[ui\zone_map_16.xml]]
            or xml_file_name == [[ui\zone_map_21.xml]])
        then
            clock.patch_zone_map(xml_obj)
        end
    end)
end
