<string_table>
	<string id="ui_mcm_menu_elseform_fih">
		<text>%c[255,190,90,255]FIH</text>
	</string>
	<string id="ui_mcm_elseform_fih_title">
		<text>Flashing Inventory Highlights</text>
	</string>
	<string id="ui_mcm_elseform_fih_enabled">
		<text>Pulse</text>
	</string>
	<string id="ui_mcm_elseform_fih_enabled_desc">
		<text>Pulse the highlight on related items (compatible attachments, upgrade tools) instead of a static glow.</text>
	</string>
	<string id="ui_mcm_elseform_fih_timing_preset">
		<text>Timing</text>
	</string>
	<string id="ui_mcm_elseform_fih_timing_preset_desc">
		<text>Sets the pulse period and, when Linger is enabled, the total rise-hold-fade exit duration.</text>
	</string>
	<string id="ui_mcm_elseform_fih_use_custom_timing">
		<text>Custom timing</text>
	</string>
	<string id="ui_mcm_elseform_fih_use_custom_timing_desc">
		<text>Use the Pulse period and Linger duration sliders below instead of the selected Timing preset.</text>
	</string>
	<string id="ui_mcm_elseform_fih_linger_enabled">
		<text>Linger</text>
	</string>
	<string id="ui_mcm_elseform_fih_linger_enabled_desc">
		<text>After unhover, quickly brighten related-item highlights, hold them briefly, then fade them out on a predictable timer.</text>
	</string>
	<string id="ui_mcm_elseform_fih_exit_duration">
		<text>Linger duration (seconds)</text>
	</string>
	<string id="ui_mcm_elseform_fih_exit_duration_desc">
		<text>Total rise, full-bright hold, and fade time when Custom timing is enabled. Set to zero for an immediate clear.</text>
	</string>
	<string id="ui_mcm_elseform_fih_period">
		<text>Pulse period (seconds)</text>
	</string>
	<string id="ui_mcm_elseform_fih_period_desc">
		<text>Duration of one full bright-dim-bright cycle when Custom timing is enabled.</text>
	</string>
	<string id="ui_mcm_lst_fih_timing_snappy">
		<text>Snappy (0.8 / 0.4 s)</text>
	</string>
	<string id="ui_mcm_lst_fih_timing_responsive">
		<text>Responsive (1.0 / 0.6 s)</text>
	</string>
	<string id="ui_mcm_lst_fih_timing_balanced">
		<text>Balanced (1.2 / 0.8 s)</text>
	</string>
	<string id="ui_mcm_lst_fih_timing_calm">
		<text>Calm (1.5 / 1.0 s)</text>
	</string>
	<string id="ui_mcm_lst_fih_timing_slow">
		<text>Slow (1.8 / 1.2 s)</text>
	</string>
	<string id="ui_mcm_elseform_fih_min_bright">
		<text>Minimum brightness (%)</text>
	</string>
	<string id="ui_mcm_elseform_fih_min_bright_desc">
		<text>Highlight intensity at the dim point of the pulse, relative to the default highlight.</text>
	</string>
	<string id="ui_mcm_elseform_fih_max_bright">
		<text>Maximum brightness (%)</text>
	</string>
	<string id="ui_mcm_elseform_fih_max_bright_desc">
		<text>Highlight intensity at the bright point of the pulse.</text>
	</string>
	<string id="ui_mcm_elseform_fih_use_custom_clr">
		<text>Custom color</text>
	</string>
	<string id="ui_mcm_elseform_fih_use_custom_clr_desc">
		<text>Use the RGB sliders below. When enabled, they override the Color preset selection.</text>
	</string>
	<string id="ui_mcm_elseform_fih_clr_preset">
