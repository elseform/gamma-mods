-- Custom Mod Categories
--
-- CMC discovers MCM pages during the normal gathering pass. Explicit category
-- assignments are stored in the dedicated [cmc] section of axr_options.ltx;
-- missing entries are uncategorized.

local CMC_ID = "elseform_cmc"
local CONFIG_SECTION = "cmc"
local MCM_ID = "mcm"
local UNCATEGORIZED_VALUE = -1
local OTHER_VALUE = 0
local config_dirty = false

