	{ id = "favorites", value = 14, text = "ui_mcm_elseform_cmc_category_favorites" },
	{ id = "ui", value = 1, text = "ui_mcm_elseform_cmc_category_ui" },
	{ id = "gameplay", value = 2, text = "ui_mcm_elseform_cmc_category_gameplay" },
	{ id = "graphics", value = 3, text = "ui_mcm_elseform_cmc_category_graphics" },
	{ id = "crafting", value = 4, text = "ui_mcm_elseform_cmc_category_crafting" },
	{ id = "inventory", value = 5, text = "ui_mcm_elseform_cmc_category_inventory" },
	{ id = "weapons", value = 6, text = "ui_mcm_elseform_cmc_category_weapons" },
	{ id = "pda", value = 7, text = "ui_mcm_elseform_cmc_category_pda" },
	{ id = "audio", value = 8, text = "ui_mcm_elseform_cmc_category_audio" },
	{ id = "animation", value = 9, text = "ui_mcm_elseform_cmc_category_animation" },
	{ id = "controls", value = 10, text = "ui_mcm_elseform_cmc_category_controls" },
	{ id = "world", value = 11, text = "ui_mcm_elseform_cmc_category_world" },
	{ id = "ai", value = 12, text = "ui_mcm_elseform_cmc_category_ai" },
	{ id = "system", value = 13, text = "ui_mcm_elseform_cmc_category_system" },
	{ id = "other", value = OTHER_VALUE, text = "ui_mcm_elseform_cmc_category_other" },
}

local uncategorized_definition = {
	id = "uncategorized",
	value = UNCATEGORIZED_VALUE,
	text = "ui_mcm_elseform_cmc_category_uncategorized",
}

