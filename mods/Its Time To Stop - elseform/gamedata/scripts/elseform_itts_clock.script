--[[
    It's Time To Stop (ITTS) - real-time HUD clock
    Author: elseform

    Displays local wall time without owning any playtime or persistence state.
    Full installations may supply the notifications and statistics modules to
    color the clock by session length; the clock-only preset supplies neither.
--]]

local stats
local notify

local HUD = nil
local hud_next_sync = 0

local function cfg(id)
    return elseform_itts_mcm.get(id)
end

local POS = {
    tl = { right = false, bottom = false },
    tr = { right = true, bottom = false },
    bl = { right = false, bottom = true },
    br = { right = true, bottom = true },
}

local COMPASS_POS = {
    p1 = { left = false, top = false },
    replace = { left = false, top = false },
    p2 = { left = false, top = true },
    compass_al = { left = true, top = true },
    compass_bl = { left = true, top = false },
}

local compass_layout = { x = 0.84, y = 0.90 }

local CLR_PRESETS = {
    itts_clr_default = { 220, 220, 220 },
    itts_clr_white = { 255, 255, 255 },
    itts_clr_orange = { 255, 160, 40 },
    itts_clr_yellow = { 255, 230, 60 },
    itts_clr_green = { 80, 255, 120 },
    itts_clr_cyan = { 60, 230, 230 },
    itts_clr_red = { 255, 60, 60 },
    itts_clr_amber = { 255, 191, 64 },
    itts_clr_blue = { 80, 160, 255 },
    itts_clr_purple = { 190, 110, 255 },
    itts_clr_pink = { 255, 105, 180 },
    itts_clr_beige = { 179, 152, 109 },
}

local STAGE_CLR_FALLBACK = {
    good = "itts_clr_green",
    mid = "itts_clr_orange",
    bad = "itts_clr_red",
}

local FONT_PRESETS = {
    letterica16 = { getter = GetFontLetterica16Russian, height = 20 },
    letterica18 = { getter = GetFontLetterica18Russian, height = 22 },
    letterica25 = { getter = GetFontLetterica25, height = 30 },
    graffiti19 = { getter = GetFontGraffiti19Russian, height = 24 },
    graffiti22 = { getter = GetFontGraffiti22Russian, height = 28 },
}

local BLINK_PERIOD_MS = 2000
local BLINK_STEP_MS = 33
local BLINK_MIN_ALPHA = 90

class "UIIttsClock" (CUIScriptWnd)

function UIIttsClock:__init() super()
    self.xml = CScriptXmlInit()
    self.xml:ParseFile("elseform_itts_clock.xml")
    self.txt = self.xml:InitStatic("itts_clock", self)
    self.segs = {}
    self._used = 0
    self._clr = nil
    self._render = {}
    self._next_blink = 0
    self._compass_rect = Frect()
    self._font_id = nil
end

function UIIttsClock:__finalize()
end

function UIIttsClock:GetCompassAnchor(pos_id)
    local placement = COMPASS_POS[pos_id]
    if not placement then return end

    local maingame = ActorMenu and ActorMenu.get_maingame and ActorMenu.get_maingame()
    local zone_map = maingame and maingame.UIZoneMap
    if not zone_map then return end

    local background = zone_map:Background()
    if not background then return end
    background:GetAbsoluteRect(self._compass_rect)

    local rect = self._compass_rect
    local nx = placement.left and (1 - compass_layout.x) or compass_layout.x
    local ny = placement.top and (1 - compass_layout.y) or compass_layout.y
    return rect.x1 + (rect.x2 - rect.x1) * nx,
        rect.y1 + (rect.y2 - rect.y1) * ny
end

function UIIttsClock:ApplyFont(font_id)
    if self._font_id == font_id then return end

    local preset = FONT_PRESETS[font_id] or FONT_PRESETS.letterica18
    self.txt:TextControl():SetFont(preset.getter())
    self.txt:SetWndSize(vector2():set(self.txt:GetWidth(), preset.height))
    for i = 1, #self.segs do
        local seg = self.segs[i]
        seg:TextControl():SetFont(preset.getter())
        seg:SetWndSize(vector2():set(seg:GetWidth(), preset.height))
    end
    self._font_id = font_id
end

function UIIttsClock:GetSeg(i)
    local seg = self.segs[i]
    if not seg then
        seg = self.xml:InitStatic("itts_clock", self)
        local preset = FONT_PRESETS[self._font_id] or FONT_PRESETS.letterica18
        seg:TextControl():SetFont(preset.getter())
        seg:SetWndSize(vector2():set(seg:GetWidth(), preset.height))
        self.segs[i] = seg
    end
    return seg
end

function UIIttsClock:HideAll()
    self.txt:Show(false)
    for i = 1, #self.segs do
        self.segs[i]:Show(false)
    end
end

function UIIttsClock:Tick(tg)
    local color = self._clr
    if not color or tg < self._next_blink then return end

    self._next_blink = tg + BLINK_STEP_MS
    local phase = (tg % BLINK_PERIOD_MS) / BLINK_PERIOD_MS
    local wave = 0.5 + 0.5 * math.cos(phase * 2 * math.pi)
    local alpha = math.floor(BLINK_MIN_ALPHA + (255 - BLINK_MIN_ALPHA) * wave)
    for i = 2, self._used, 2 do
        self.segs[i]:TextControl():SetTextColor(
            GetARGB(alpha, color[1], color[2], color[3]))
    end
end

local function clock_color()
    local stage = notify and stats
        and notify.get_clock_stage(stats.get_session_ms())
    if stage then
        return CLR_PRESETS[cfg("clock_progressive_clr_" .. stage)]
            or CLR_PRESETS[STAGE_CLR_FALLBACK[stage]]
    end
    if cfg("clock_custom") then
        return { cfg("clock_r") or 220, cfg("clock_g") or 220, cfg("clock_b") or 220 }
    end
    return CLR_PRESETS[cfg("clock_clr")] or CLR_PRESETS.itts_clr_default
end

function UIIttsClock:Refresh()
    local font_id = cfg("clock_font")
    local text = os.date(cfg("clock_24h") and "%H:%M" or "%I:%M %p")
    local blink = cfg("clock_blink") and true or false
    local pos_id = cfg("clock_pos")
    local ox = cfg("clock_off_x") or 0
    local oy = cfg("clock_off_y") or 0
    local color = clock_color()

    -- Poll every second for MCM changes, but touch UI state only when the
    -- rendered result changes, normally at the next minute.
    local prev = self._render
    if prev.text == text and prev.font_id == font_id and prev.blink == blink
        and prev.pos_id == pos_id and prev.ox == ox and prev.oy == oy
        and prev.r == color[1] and prev.g == color[2] and prev.b == color[3]
    then
        return
    end
    self._clr = nil
    self:ApplyFont(font_id)

    local w, h
    if blink then
        self.txt:Show(false)
        local chunks = str_explode(text, ":")
        self._used = 2 * #chunks - 1
        w = 0
        for i = 1, self._used do
            local seg = self:GetSeg(i)
            seg:TextControl():SetText(i % 2 == 1 and chunks[(i + 1) / 2] or ":")
            seg:AdjustWidthToText()
            w = w + seg:GetWidth()
        end
        for i = self._used + 1, #self.segs do
            self.segs[i]:Show(false)
        end
        h = self.segs[1]:GetHeight()
    else
        for i = 1, #self.segs do
            self.segs[i]:Show(false)
        end
        self._used = 0
        self.txt:TextControl():SetText(text)
        self.txt:AdjustWidthToText()
        w, h = self.txt:GetWidth(), self.txt:GetHeight()
    end

    local x, y
    if COMPASS_POS[pos_id] then
        local cx, cy = self:GetCompassAnchor(pos_id)
        if not cx then
            self:HideAll()
            return
        end
        x = cx - w / 2 + ox
        y = cy - h / 2 + oy
    else
        local pos = POS[pos_id] or POS.tr
        x = (pos.right and (1024 - w - 15) or 15) + ox
        y = (pos.bottom and (768 - h - 10) or 10) + oy
    end

    -- A missing minimap anchor must retry next poll rather than cache a hidden
    -- result, so the render key is committed only after placement succeeds.
    prev.text, prev.font_id, prev.blink = text, font_id, blink
    prev.pos_id, prev.ox, prev.oy = pos_id, ox, oy
    prev.r, prev.g, prev.b = color[1], color[2], color[3]

    local argb = GetARGB(255, color[1], color[2], color[3])
    if blink then
        local cursor = x
        for i = 1, self._used do
            local seg = self.segs[i]
            seg:SetWndPos(vector2():set(cursor, y))
            cursor = cursor + seg:GetWidth()
            seg:TextControl():SetTextColor(argb)
            seg:Show(true)
        end
        self._clr = color
        self._next_blink = 0
    else
        self.txt:SetWndPos(vector2():set(x, y))
        self.txt:TextControl():SetTextColor(argb)
        self.txt:Show(true)
    end
end

local function activate_hud()
    if HUD == nil then
        HUD = UIIttsClock()
        get_hud():AddDialogToRender(HUD)
    end
end

local function deactivate_hud()
    if HUD ~= nil then
        get_hud():RemoveDialogToRender(HUD)
        HUD = nil
    end
end

function actor_on_update(tg)
    if tg >= hud_next_sync then
        hud_next_sync = tg + 1000
        if cfg("clock_enabled") then
            activate_hud()
            HUD:Refresh()
        else
            deactivate_hud()
        end
    end

    if HUD and HUD._clr and tg >= HUD._next_blink then
        HUD:Tick(tg)
    end
end

function actor_on_first_update()
    hud_next_sync = 0
end

function actor_on_net_destroy()
    deactivate_hud()
    hud_next_sync = 0
end

function on_screen_resolution_changed()
    deactivate_hud()
    hud_next_sync = 0
end

function on_game_start(stats_module, notify_module)
    stats = stats_module
    notify = notify_module
end

-- HUD XML ---------------------------------------------------------------------

function patch_zone_map(xml_obj)
    local clock_wnd = xml_obj:query("minimap > clock_wnd")[1]
    if not clock_wnd then return end

    local attr = xml_obj:getElementAttr(clock_wnd)
    local anchor_x = tonumber(attr.x)
    local anchor_y = tonumber(attr.y)
    if anchor_x and anchor_x >= 0 and anchor_x <= 1 then
        compass_layout.x = anchor_x
    end
    if anchor_y and anchor_y >= 0 and anchor_y <= 1 then
        compass_layout.y = anchor_y
    end

    -- Below-right can swap with or replace the stock in-game clock while
    -- preserving custom HUD geometry instead of assuming the stock anchor.
    local pos = cfg("clock_pos")
    if anchor_x then
        if pos == "p1" then
            xml_obj:setElementAttr(clock_wnd, { x = string.format("%.6g", 1 - anchor_x) })
        elseif pos == "replace" then
            xml_obj:setElementAttr(clock_wnd, { x = 5, y = 5 })
        end
    end
end
