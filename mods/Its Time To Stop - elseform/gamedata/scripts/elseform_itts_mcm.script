--[[
    It's Time To Stop (ITTS) - shared MCM settings
    Author: elseform

    Feature pages live in separate *_mcm scripts and join the elseform_itts
    collection. Runtime modules use get() so MCM remains optional and existing
    elseform_itts/<page>/<id> option paths stay compatible with 1.0.x.
--]]

DEF = {
    clock = {
        clock_enabled = true,
        clock_pos = "p2",
        clock_off_x = 0,
        clock_off_y = 0,
        clock_24h = true,
        clock_blink = true,
        clock_font = "letterica16",
        clock_clr = "itts_clr_amber",
        clock_custom = false,
        clock_r = 220,
        clock_g = 220,
        clock_b = 220,
    },
    notify = {
        notify_enabled = false,
        notify_good = 120,
        notify_bad = 180,
        notify_repeat = false,
        notify_repeat_min = 15,
        notify_sound = true,
        clock_progressive = false,
        clock_progressive_clr_good = "itts_clr_green",
        clock_progressive_clr_mid = "itts_clr_orange",
        clock_progressive_clr_bad = "itts_clr_red",
    },
    stats = {
        show_total = true,
        show_session = true,
        units = "hm",
        session_count_pause = false,
        session_count_loadings = true,
        session_break_min = 20,
    },
}

local PAGE = {}
for page, options in pairs(DEF) do
    for id in pairs(options) do
        PAGE[id] = page
    end
end

function get(id)
    local page = PAGE[id]
    if not page then return nil end
    if ui_mcm and ui_mcm.get then
        local value = ui_mcm.get("elseform_itts/" .. page .. "/" .. id)
        if value ~= nil then return value end
    end
    return DEF[page][id]
end

CLR_CONTENT = {
    { "itts_clr_default", "itts_clr_default" },
    { "itts_clr_white", "itts_clr_white" },
    { "itts_clr_orange", "itts_clr_orange" },
    { "itts_clr_yellow", "itts_clr_yellow" },
    { "itts_clr_green", "itts_clr_green" },
    { "itts_clr_cyan", "itts_clr_cyan" },
    { "itts_clr_red", "itts_clr_red" },
    { "itts_clr_amber", "itts_clr_amber" },
    { "itts_clr_blue", "itts_clr_blue" },
    { "itts_clr_purple", "itts_clr_purple" },
    { "itts_clr_pink", "itts_clr_pink" },
    { "itts_clr_beige", "itts_clr_beige" },
}

function title()
    return {
        id = "title",
        type = "slide",
        link = "ui_options_slider_player",
        text = "ui_mcm_itts_stat_title",
        size = { 512, 50 },
        spacing = 20,
    }
end
