--[[
    It's Time To Stop (ITTS) - module dispatcher
    Author: elseform

    The installer supplies any of three feature modules: HUD clock, playtime
    statistics, and session notifications. This dispatcher is shared by every
    preset and registers only the callbacks required by the installed modules.
    Full installations still use one actor-update callback.
--]]

local clock
local stats
local notify

local function actor_on_update()
    local tg = time_global()

    if stats then
        stats.actor_on_update(tg, os.time(), notify)
    end
    if clock then
        clock.actor_on_update(tg)
    end
end

local function save_state(m_data)
    stats.save_state(m_data)
end

local function load_state(m_data)
    stats.load_state(m_data)
end

local function actor_on_first_update()
    if clock then clock.actor_on_first_update() end
end

local function actor_on_net_destroy()
    if stats then stats.actor_on_net_destroy(os.time(), notify) end
    if clock then clock.actor_on_net_destroy() end
end

local function on_screen_resolution_changed()
    clock.on_screen_resolution_changed()
end

function on_game_start()
    clock = elseform_itts_clock
    stats = elseform_itts_stats
    notify = elseform_itts_notify

    -- Notifications are distributed only with statistics, but treating a
    -- stray notification script as absent makes a broken manual install inert.
    if notify and not stats then notify = nil end

    if stats then stats.on_game_start() end
    if notify then notify.on_game_start() end
    if clock then clock.on_game_start(stats, notify) end

    if stats or clock then
        RegisterScriptCallback("actor_on_update", actor_on_update)
        RegisterScriptCallback("actor_on_net_destroy", actor_on_net_destroy)
    end
    if stats then
        RegisterScriptCallback("save_state", save_state)
        RegisterScriptCallback("load_state", load_state)
    end
    if clock then
        RegisterScriptCallback("actor_on_first_update", actor_on_first_update)
        RegisterScriptCallback("on_screen_resolution_changed", on_screen_resolution_changed)
    end
end
