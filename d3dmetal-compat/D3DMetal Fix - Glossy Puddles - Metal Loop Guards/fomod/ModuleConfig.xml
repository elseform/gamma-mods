<?xml version="1.0" encoding="utf-8"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:noNamespaceSchemaLocation="http://qconsulting.ca/fo3/ModConfig5.0.xsd">
  <moduleName>D3DMetal Fix - Glossy Puddles - Metal Loop Guards</moduleName>
  <requiredInstallFiles>
    <file source="meta.ini" destination="meta.ini" />
    <file source="README.md" destination="README.md" />
  </requiredInstallFiles>
  <installSteps order="Explicit">
    <installStep name="Install Glossy Puddles loop guards">
      <optionalFileGroups order="Explicit">
        <group name="Package" type="SelectExactlyOne">
          <plugins order="Explicit">
            <plugin name="Glossy Puddles loop guards">
              <description>Installs a guarded Glossy Puddles 1.4 terrain shader that prevents unbounded parallax loops while preserving reflection-strength control. Load after Glossy Puddles and clear appdata/shaders_cache/.</description>
              <files>
                <folder source="gamedata" destination="gamedata" />
              </files>
              <typeDescriptor>
                <type name="Recommended" />
              </typeDescriptor>
            </plugin>
          </plugins>
        </group>
      </optionalFileGroups>
    </installStep>
  </installSteps>
</config>
