<?xml version="1.0" encoding="utf-8"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:noNamespaceSchemaLocation="http://qconsulting.ca/fo3/ModConfig5.0.xsd">
  <moduleName>Fits Into These Slots</moduleName>
  <moduleImage path="fomod\FITS12.png" />
  <requiredInstallFiles>
    <file source="README.md" destination="README.md" />
  </requiredInstallFiles>
  <installSteps order="Explicit">
    <installStep name="Install Fits Into These Slots">
      <optionalFileGroups order="Explicit">
        <group name="Package" type="SelectExactlyOne">
          <plugins order="Explicit">
            <plugin name="Fits Into These Slots">
              <description>Lets whitelisted weapons be equipped into the pistol or binoculars slot, either by right-clicking them into an allow-list or, in an optional Rank-based mode, automatically by weapon kind as you rank up.</description>
              <image path="fomod\FITS12.png" />
              <files>
                <folder source="gamedata" destination="gamedata" />
              </files>
              <typeDescriptor>
                <type name="Recommended" />
              </typeDescriptor>
            </plugin>
          </plugins>
        </group>
      </optionalFileGroups>
    </installStep>
  </installSteps>
</config>
