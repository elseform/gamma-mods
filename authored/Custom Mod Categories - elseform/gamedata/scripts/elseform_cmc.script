-- Custom Mod Categories
--
-- CMC discovers MCM pages during the normal gathering pass. Its mutable state
-- lives in gamedata/configs/plugins/elseform_cmc.ltx; missing assignments use
-- built-in defaults, or Uncategorized when no default exists.
--
-- [cmc] section: one line per mod, "<mcm_group_id> = <category_value>".
-- <category_value> matches a "value" below: 0-13 and OTHER_VALUE/-1 are
-- builtin (see default_categories), 1000+ are custom categories.
--
-- [cmc_categories] section: builtin category overrides use
-- "<value>_name/_pinned/_deleted" keys.
--
-- [cmc_custom_categories] section: one custom category per row, keyed by its
-- numeric value: "<value> = <pinned 0/1>,<name>". Values start at 1000. CMC
-- calculates the next value from existing rows, and names may contain commas.
--
-- [cmc_settings] section: CMC-wide settings that do not belong to a category.

local CMC_ID = "elseform_cmc"
local CONFIG_PATH = "plugins\\elseform_cmc.ltx"
local CONFIG_SECTION = "cmc"
local CAT_CONFIG_SECTION = "cmc_categories"
local CUSTOM_CAT_CONFIG_SECTION = "cmc_custom_categories"
local SETTINGS_CONFIG_SECTION = "cmc_settings"
local FORCE_ENGLISH_KEY = "force_english_mcm"
local MCM_ID = "mcm"
local UNCATEGORIZED_VALUE = -1
local OTHER_VALUE = 0
local config_dirty = false
local cmc_config = nil
local legacy_config_processed = false
local rebuild_manage_group
local delete_all_categories_action
local restore_default_categories_action

-- DEV_DEBUG is an engine global (set from the game's -dbg launch option, same
-- flag ui_mcm.script's debug_only() precondition reads) -- checked live, not
-- cached at module load, since script load order does not guarantee it is
-- already set.
local function dbg_log(fmt, ...)
	if not DEV_DEBUG or not printf then return end
	if select("#", ...) == 0 then
		printf("[CMC] " .. tostring(fmt))
	else
		local ok, res = pcall(string.format, fmt, ...)
		if ok then
			printf("[CMC] " .. res)
		else
			printf("[CMC] (fmt error) " .. tostring(fmt))
		end
	end
end

local function remove_section_lines(config, section)
	if not config:section_exist(section) then return false end
	local changed = false
	for key, _ in pairs(config:collect_section(section) or {}) do
		config:remove_line(section, key)
		changed = true
	end
	return changed
end

local function migrate_legacy_config(config)
	if legacy_config_processed then return end
	local legacy = axr_main and axr_main.config
	if not legacy then return end

	local migrated_assignments = 0
	local migrated_locale = false
	if legacy:section_exist(CONFIG_SECTION) then
		for mod_id, assigned_value in pairs(legacy:collect_section(CONFIG_SECTION) or {}) do
			local value = tonumber(assigned_value)
			if value and value % 1 == 0 and value >= UNCATEGORIZED_VALUE and value <= 14 then
				config:w_value(CONFIG_SECTION, mod_id, tostring(value))
				migrated_assignments = migrated_assignments + 1
			end
		end
	end
	if legacy:section_exist("mcm") and legacy:line_exist("mcm", "mcm/mcm_about/dxml") then
		local force_english = legacy:r_value("mcm", "mcm/mcm_about/dxml", 1, false)
		config:w_value(SETTINGS_CONFIG_SECTION, FORCE_ENGLISH_KEY, force_english)
		migrated_locale = true
	end
	if migrated_assignments > 0 or migrated_locale then
		-- Commit destination first. If saving fails, legacy state remains intact.
		config:save()
		dbg_log(
			"migrated legacy CMC state: assignments=%d, locale=%s",
			migrated_assignments,
			tostring(migrated_locale)
		)
	end

	local legacy_changed = remove_section_lines(legacy, CONFIG_SECTION)
	legacy_changed = remove_section_lines(legacy, CAT_CONFIG_SECTION) or legacy_changed
	if legacy:section_exist("mcm") then
		local legacy_mcm_keys = {
			"mcm/mcm_about/dxml",
			"mcm/elseform_cmc_manage/new_name",
			"mcm/elseform_cmc_manage/new_pinned",
		}
		for i = 1, #legacy_mcm_keys do
			local key = legacy_mcm_keys[i]
			if legacy:line_exist("mcm", key) then
				legacy:remove_line("mcm", key)
				legacy_changed = true
			end
		end
	end
	if legacy_changed then
		legacy:save()
		dbg_log("removed legacy CMC state from axr_options.ltx")
	end
	legacy_config_processed = true
end

local function get_cmc_config()
	if not cmc_config then
		cmc_config = ini_file_ex(CONFIG_PATH, true)
		assert(cmc_config, "CMC could not open " .. CONFIG_PATH)
	end
	migrate_legacy_config(cmc_config)
	if not cmc_config:line_exist(SETTINGS_CONFIG_SECTION, FORCE_ENGLISH_KEY) then
		cmc_config:w_value(SETTINGS_CONFIG_SECTION, FORCE_ENGLISH_KEY, false)
		cmc_config:save()
	end
	return cmc_config
end

local function parse_custom_category(value)
	local pinned, name = tostring(value or ""):match("^%s*([01])%s*,(.*)$")
	name = name and name:match("^%s*(.-)%s*$") or ""
	if not pinned or name == "" then return nil end
	return name, pinned == "1"
end

local function write_custom_category(config, value, name, pinned)
	config:w_value(
		CUSTOM_CAT_CONFIG_SECTION,
		tostring(value),
		string.format("%d,%s", pinned and 1 or 0, name)
	)
end

local function cleanup_old_custom_format(config)
	if not config:section_exist(CAT_CONFIG_SECTION) then return end
	local removed_values = {}
	local changed = false
	for key, _ in pairs(config:collect_section(CAT_CONFIG_SECTION) or {}) do
		local value, suffix = tostring(key):match("^(%d+)_(%a+)$")
		value = tonumber(value)
		local is_custom_field = value and value >= 1000
			and (suffix == "name" or suffix == "pinned" or suffix == "deleted")
		if key == "next_id" or is_custom_field then
			config:remove_line(CAT_CONFIG_SECTION, key)
			changed = true
			if is_custom_field then removed_values[value] = true end
		end
	end
	if changed and config:section_exist(CONFIG_SECTION) then
		for mod_id, assigned_value in pairs(config:collect_section(CONFIG_SECTION) or {}) do
			local value = tonumber(assigned_value)
			if value and removed_values[value]
				and not config:line_exist(CUSTOM_CAT_CONFIG_SECTION, tostring(value)) then
				config:w_value(CONFIG_SECTION, mod_id, tostring(UNCATEGORIZED_VALUE))
			end
		end
	end
	if changed then
		config:save()
		dbg_log("removed old-format custom categories without migration")
	end
end

function get_force_english_mcm()
	return get_cmc_config():r_value(SETTINGS_CONFIG_SECTION, FORCE_ENGLISH_KEY, 1, false)
end

function set_force_english_mcm(value)
	local config = get_cmc_config()
	config:w_value(SETTINGS_CONFIG_SECTION, FORCE_ENGLISH_KEY, value and true or false)
	config:save()
end

