local loaded_categories = {}
local category_by_value = {}
local next_custom_id = 1000

local manage_group_ref = nil

local function get_cat_display_name(cat)
	if not cat then
		dbg_log("get_cat_display_name(nil) -> ''")
		return ""
	end
	if type(cat) == "number" or type(cat) == "string" then
		cat = category_by_value[tonumber(cat)]
	end
	if not cat then
		dbg_log("get_cat_display_name(unknown) -> ''")
		return ""
	end
	local res
	if cat.name and cat.name ~= "" then
		res = cat.name
	elseif cat.text then
		res = game.translate_string(cat.text)
	else
		res = cat.id or tostring(cat.value or "")
	end
	dbg_log("get_cat_display_name(val=%s, id=%s) -> '%s'", tostring(cat.value), tostring(cat.id), tostring(res))
	return res
end

local function load_categories()
	local config = get_cmc_config()
	cleanup_old_custom_format(config)
	dbg_log("load_categories() start. section_exist=%s", tostring(config:section_exist(CAT_CONFIG_SECTION)))
	loaded_categories = {}
	category_by_value = {}
	
	for i = 1, #default_categories do
		local base = default_categories[i]
		local cat = {
			value = base.value,
			id = base.id,
			text = base.text,
			name = base.name,
			pinned = base.pinned,
			deleted = base.deleted,
			builtin = true,
			orig_order = i
		}
		if config:section_exist(CAT_CONFIG_SECTION) then
			local pfx = tostring(cat.value) .. "_"
			local override_name = config:r_value(CAT_CONFIG_SECTION, pfx .. "name", 0, "")
			if override_name ~= "" then cat.name = override_name end
			cat.pinned = config:r_value(CAT_CONFIG_SECTION, pfx .. "pinned", 1, cat.pinned or false)
			cat.deleted = config:r_value(CAT_CONFIG_SECTION, pfx .. "deleted", 1, false)
		end
		loaded_categories[#loaded_categories + 1] = cat
		category_by_value[cat.value] = cat
		dbg_log("  [builtin] val=%d, id='%s', name='%s', pinned=%s, deleted=%s", cat.value, cat.id, tostring(cat.name or ""), tostring(cat.pinned), tostring(cat.deleted))
	end
	
	next_custom_id = 1000
	local seen_names = {}
	for _, cat in ipairs(loaded_categories) do
		if cat.builtin and not cat.deleted then
			seen_names[get_cat_display_name(cat):lower()] = true
		end
	end
	local custom_categories = {}
	if config:section_exist(CUSTOM_CAT_CONFIG_SECTION) then
		for key, encoded in pairs(config:collect_section(CUSTOM_CAT_CONFIG_SECTION) or {}) do
			local value = tonumber(key)
			if value and value >= 1000 and value % 1 == 0 then
				if value >= next_custom_id then next_custom_id = value + 1 end
				local name, pinned = parse_custom_category(encoded)
				if not name then
					dbg_log("  [custom] skipping malformed category val=%d", value)
				else
					custom_categories[#custom_categories + 1] = {
						value = value,
						id = tostring(value),
						name = name,
						pinned = pinned,
						deleted = false,
						builtin = false,
						orig_order = 100 + value,
					}
				end
			end
		end
	end
	table.sort(custom_categories, function(a, b) return a.value < b.value end)
	for i = 1, #custom_categories do
		local cat = custom_categories[i]
		if seen_names[cat.name:lower()] then
			dbg_log("  [custom] skipping duplicate category val=%d, name='%s'", cat.value, cat.name)
		else
			seen_names[cat.name:lower()] = true
			loaded_categories[#loaded_categories + 1] = cat
			category_by_value[cat.value] = cat
			dbg_log("  [custom] loaded val=%d, name='%s', pinned=%s", cat.value, cat.name, tostring(cat.pinned))
		end
	end
	category_by_value[UNCATEGORIZED_VALUE] = uncategorized_definition
	dbg_log("load_categories() done. total loaded=%d, next_custom_id=%d", #loaded_categories, next_custom_id)
end

local draft_new_name = ""
local draft_new_pinned = false
local pending_custom_edits = {}

local function get_new_name()
	return draft_new_name
end

local function set_new_name(val)
	draft_new_name = tostring(val or ""):match("^%s*(.-)%s*$") or ""
end

-- True if any non-deleted category (other than exclude_val) already displays
-- as name_lower. exclude_val nil matches nothing, so a new-category check can
-- omit it.
local function is_duplicate_name(name_lower, exclude_val)
	for _, cat in ipairs(loaded_categories) do
		if cat.value ~= exclude_val and not cat.deleted and get_cat_display_name(cat):lower() == name_lower then
			return true
		end
	end
	return false
end

-- Persists the staged new-category name/pinned pair (if any) into
-- CUSTOM_CAT_CONFIG_SECTION. Called from on_mcm_apply, i.e. only when the user
-- commits the whole MCM page via Apply -- never on a per-field blur.
local function commit_staged_category()
	if draft_new_name == "" then return end
	local config = get_cmc_config()
	if is_duplicate_name(draft_new_name:lower()) then
		dbg_log("  rejected duplicate staged category name '%s' on apply", draft_new_name)
		return
	end
	local new_val = next_custom_id
	write_custom_category(config, new_val, draft_new_name, draft_new_pinned)
	next_custom_id = new_val + 1
	config:save()
	dbg_log("  created new category on apply: val=%d, name='%s', pinned=%s", new_val, draft_new_name, tostring(draft_new_pinned))
end

local function get_new_pinned()
	return draft_new_pinned
end

local function set_new_pinned(val)
	draft_new_pinned = (val == true)
end

local function get_manage_val(val, prop)
	local cat = category_by_value[tonumber(val)]
	local res
	if not cat then
		if prop == "name" then res = "" else res = false end
	elseif prop == "name" then
		res = cat.name or ""
	elseif prop == "pinned" then
		res = cat.pinned or false
	elseif prop == "deleted" then
		res = cat.deleted or false
	else
		res = false
	end
	dbg_log("get_manage_val(val=%s, prop='%s') -> %s", tostring(val), tostring(prop), tostring(res))
	return res
end

local function get_manage_default(val, prop)
	local cat = category_by_value[tonumber(val)]
	local res
	if not cat then
		if prop == "name" then res = "" else res = false end
	elseif cat.builtin then
		local ship = default_categories[cat.orig_order]
		if prop == "name" then res = ""
		elseif prop == "pinned" then res = ship.pinned or false
		elseif prop == "deleted" then res = false
		else res = false end
	else
		if prop == "name" then res = cat.name or ""
		elseif prop == "pinned" then res = cat.pinned or false
		elseif prop == "deleted" then res = false
		else res = false end
	end
	dbg_log("get_manage_default(val=%s, prop='%s') -> %s", tostring(val), tostring(prop), tostring(res))
	return res
end

local function set_manage_val(val, prop, value)
	dbg_log("set_manage_val(val=%s, prop='%s', value=%s)", tostring(val), tostring(prop), tostring(value))
	local config = get_cmc_config()
	local pfx = tostring(val) .. "_"
	local num_val = tonumber(val)
	local cat = category_by_value[num_val]
	local new_name = nil
	if prop == "name" then
		new_name = tostring(value or ""):match("^%s*(.-)%s*$") or ""
		if new_name == "" then
			dbg_log("  empty name for val=%s ignored, keeping existing name", tostring(val))
			return
		end
		if is_duplicate_name(new_name:lower(), num_val) then
			dbg_log("  rejected duplicate category name '%s' for val=%s", new_name, tostring(val))
			return
		end
	end
	if cat and not cat.builtin then
		local pending = pending_custom_edits[num_val] or {}
		pending_custom_edits[num_val] = pending
		if prop == "name" then
			pending.name = new_name
		elseif prop == "pinned" then
			pending.pinned = value and true or false
		elseif prop == "deleted" then
			pending.deleted = value and true or false
		end
		dbg_log("  staged custom category edit for val=%d", num_val)
		return
	end
	if prop == "name" then
		config:w_value(CAT_CONFIG_SECTION, pfx .. "name", new_name)
	elseif prop == "pinned" then
		config:w_value(CAT_CONFIG_SECTION, pfx .. "pinned", value and true or false)
	elseif prop == "deleted" then
		local is_deleted = value and true or false
		config:w_value(CAT_CONFIG_SECTION, pfx .. "deleted", is_deleted)
		if is_deleted and config:section_exist(CONFIG_SECTION) then
			local sec = config:collect_section(CONFIG_SECTION)
			for mod_id, assigned_val in pairs(sec) do
				if tonumber(assigned_val) == num_val then
					config:w_value(CONFIG_SECTION, mod_id, tostring(UNCATEGORIZED_VALUE))
				end
			end
		end
	end
	config:save()
	dbg_log("  saved CMC config")
end

local function reassign_category(config, value)
	if not config:section_exist(CONFIG_SECTION) then return end
	for mod_id, assigned_value in pairs(config:collect_section(CONFIG_SECTION) or {}) do
		if tonumber(assigned_value) == value then
			config:w_value(CONFIG_SECTION, mod_id, tostring(UNCATEGORIZED_VALUE))
		end
	end
end

local function commit_staged_custom_edits()
	local config = get_cmc_config()
	local changed = false
	for value, edit in pairs(pending_custom_edits) do
		local cat = category_by_value[value]
		if cat and not cat.builtin then
			if edit.deleted then
				config:remove_line(CUSTOM_CAT_CONFIG_SECTION, tostring(value))
				reassign_category(config, value)
			else
				local name = edit.name or cat.name
				local pinned = edit.pinned
				if pinned == nil then pinned = cat.pinned end
				write_custom_category(config, value, name, pinned)
			end
			changed = true
		end
	end
	pending_custom_edits = {}
	if changed then
		config:save()
		dbg_log("  committed staged custom category edits")
	end
end

rebuild_manage_group = function()
	dbg_log("rebuild_manage_group() start. manage_group_ref=%s", tostring(manage_group_ref ~= nil))
	if not manage_group_ref then return end
	local rows = {}
	rows[#rows + 1] = { id = "manage_title", type = "title", text = "ui_mcm_elseform_cmc_manage_title" }
	rows[#rows + 1] = { id = "manage_desc", type = "desc", text = "ui_mcm_elseform_cmc_manage_desc" }
	rows[#rows + 1] = { 
		id = "new_name", type = "input", val = 0, def = "", no_str = true, 
		caption = game.translate_string("ui_mcm_elseform_cmc_manage_new_name"),
		curr = { get_new_name },
		functor = { set_new_name }
	}
	rows[#rows + 1] = { 
		id = "new_pinned", type = "check", val = 1, def = false, 
		hint = "ui_mcm_elseform_cmc_manage_new_pinned",
		curr = { get_new_pinned },
		functor = { set_new_pinned }
	}
	rows[#rows + 1] = { id = "manage_sep1", type = "line" }

	for i = 1, #loaded_categories do
		local cat = loaded_categories[i]
		if cat.id ~= "favorites" and cat.id ~= "all" and cat.id ~= "uncategorized" and not cat.deleted then
			local pfx = tostring(cat.value) .. "_"
			rows[#rows + 1] = { id = pfx.."desc", type = "desc", text = get_cat_display_name(cat), clr = {255, 100, 255, 100} }
			rows[#rows + 1] = { 
				id = pfx .. "name", type = "input", val = 0, no_str = true, caption = game.translate_string("ui_mcm_elseform_cmc_manage_name"),
				def = { get_manage_default, cat.value, "name" },
				curr = { get_manage_val, cat.value, "name" }, 
				functor = { set_manage_val, cat.value, "name" } 
			}
			rows[#rows + 1] = { 
				id = pfx .. "pinned", type = "check", val = 1, hint = "ui_mcm_elseform_cmc_manage_pinned",
				def = { get_manage_default, cat.value, "pinned" },
				curr = { get_manage_val, cat.value, "pinned" }, 
				functor = { set_manage_val, cat.value, "pinned" } 
			}
			rows[#rows + 1] = { 
				id = pfx .. "deleted", type = "check", val = 1, hint = "ui_mcm_elseform_cmc_manage_deleted",
				def = { get_manage_default, cat.value, "deleted" },
				curr = { get_manage_val, cat.value, "deleted" }, 
				functor = { set_manage_val, cat.value, "deleted" } 
			}
			rows[#rows + 1] = { id = pfx .. "sep", type = "line" }
		end
	end

	rows[#rows + 1] = { id = "delete_all_categories_notice", type = "desc", text = "ui_mcm_elseform_cmc_delete_all_categories_notice", clr = {255, 200, 80, 80} }
	rows[#rows + 1] = {
		id = "delete_all_categories", type = "button",
		hint = "elseform_cmc_delete_all_categories",
		functor_ui = {
			function(mcm_ui)
				dbg_log("delete_all_categories button clicked!")
				delete_all_categories_action(mcm_ui)
			end,
		}
	}
	rows[#rows + 1] = {
		id = "restore_default_categories", type = "button",
		hint = "elseform_cmc_restore_default_categories",
		functor_ui = {
			function(mcm_ui)
				dbg_log("restore_default_categories button clicked!")
				restore_default_categories_action(mcm_ui)
			end,
		}
	}
	rows[#rows + 1] = { id = "manage_sep2", type = "line" }

	manage_group_ref.gr = rows
	dbg_log("rebuild_manage_group() done. total rows=%d", #rows)
end

local function assignment_option_id(group_id)
	return "assign_" .. group_id
end

local function category_options()
	local content = {}
	for i = 1, #loaded_categories do
		local cat = loaded_categories[i]
		if not cat.deleted then
			content[#content + 1] = { cat.value, get_cat_display_name(cat) }
		end
	end
	content[#content + 1] = { uncategorized_definition.value, uncategorized_definition.text }
	dbg_log("category_options() returning %d entries", #content)
	return content
end

local function organizer_caption(group)
	local text = game.translate_string(group.text or "ui_mcm_menu_" .. group.id)
	return (text:gsub("%%c%b[]", ""))
end

-- Falls back to default_assignments below when [cmc] has no explicit value,
-- so first-launch defaults apply dynamically without writing them into config.
local function read_assignment(group_id)
	local value = get_cmc_config():r_value(CONFIG_SECTION, group_id, 2)
	local cat = nil
	if value ~= nil then
		cat = category_by_value[tonumber(value)]
	else
		local def_val = default_assignments[group_id]
		cat = def_val and category_by_value[def_val]
	end
	if not cat or cat.deleted then
		cat = uncategorized_definition
	end
	dbg_log("read_assignment('%s') -> val=%s, cat_id='%s'", group_id, tostring(value), cat.id)
	return cat
end


local function get_assignment(group_id)
	local cat = read_assignment(group_id)
	return cat.value
end

local function get_default_assignment(group_id)
	local value = default_assignments[group_id]
	local res = value == nil and UNCATEGORIZED_VALUE or value
	dbg_log("get_default_assignment('%s') -> %s", group_id, tostring(res))
	return res
end

local function set_assignment(group_id, value)
	dbg_log("set_assignment(group_id='%s', value=%s)", group_id, tostring(value))
	local definition = category_by_value[tonumber(value)] or uncategorized_definition
	local config = get_cmc_config()
	config:w_value(CONFIG_SECTION, group_id, tostring(definition.value))
	config_dirty = true
	config:save()
	dbg_log("  saved assignment: [%s] -> %s (%s)", group_id, tostring(definition.value), definition.id)
end

local function redraw_current_page(mcm_ui)
	if mcm_ui and mcm_ui.last_curr_tree and mcm_ui.last_path then
		dbg_log("redraw_current_page() tree=%s, path='%s'", tostring(mcm_ui.last_curr_tree), tostring(mcm_ui.last_path))
		mcm_ui:Reset_opt(mcm_ui.last_curr_tree, mcm_ui.last_path)
	end
end

-- Same tree/path reset UI_MCM:On_Accept() performs after a normal Apply, so
-- the button's own effect is immediately visible as an exit to the MCM root
-- tree instead of requiring a separate Apply click to leave the page.
local function exit_to_main_tree(mcm_ui)
	if not mcm_ui then
		return
	end
	dbg_log("exit_to_main_tree()")
	mcm_ui.active_category = nil
	mcm_ui.search_filter = nil
	mcm_ui.last_path = nil
	mcm_ui.last_curr_tree = nil
	mcm_ui.cmc_clear_search_on_refresh = true
	mcm_ui.cmc_root_refresh_pending = true
end

local function stage_clear_all(assignments, mcm_ui)
	dbg_log("stage_clear_all() clearing %d assignments", #assignments)
	local was_batching = mcm_ui.cmc_batching_cache_updates
	mcm_ui.cmc_batching_cache_updates = true
	for i = 1, #assignments do
		local assignment = assignments[i]
		mcm_ui:CacheValue(organizer_path(), assignment.id, UNCATEGORIZED_VALUE, assignment)
	end
	mcm_ui.cmc_batching_cache_updates = was_batching
	if not was_batching then
		mcm_ui:UpdatePending()
	end
	redraw_current_page(mcm_ui)
end

-- "All mods", "Favorites", and "Uncategorized" are pseudo-categories baked
-- into the UI (category_menu, category_options) and are never real editable
-- entries in stored category sections -- skip them here the same way rebuild_manage_group
-- already does.
delete_all_categories_action = function(mcm_ui)
	dbg_log("delete_all_categories_action fired")
	local config = get_cmc_config()
	local deleted_any = false
	for _, cat in ipairs(loaded_categories) do
		if cat.id ~= "favorites" and cat.id ~= "all" and cat.id ~= "uncategorized" and not cat.deleted then
			if cat.builtin then
				config:w_value(CAT_CONFIG_SECTION, tostring(cat.value) .. "_deleted", true)
			else
				config:remove_line(CUSTOM_CAT_CONFIG_SECTION, tostring(cat.value))
			end
			deleted_any = true
		end
	end
	if not deleted_any then
		dbg_log("  delete_all_categories_action: nothing to delete")
		return
	end
	if config:section_exist(CONFIG_SECTION) then
		local sec = config:collect_section(CONFIG_SECTION)
		for mod_id, assigned_val in pairs(sec) do
			local cat = category_by_value[tonumber(assigned_val)]
			if cat and cat.id ~= "favorites" and cat.id ~= "uncategorized" then
				config:w_value(CONFIG_SECTION, mod_id, tostring(UNCATEGORIZED_VALUE))
			end
		end
	end
	config:save()
	dbg_log("  delete_all_categories_action: deleted all custom/built-in categories, reassigned affected mods to Uncategorized")
	load_categories()
	if ui_mcm and ui_mcm.options then
		refresh_assignments(ui_mcm.options)
	end
	rebuild_manage_group()
	exit_to_main_tree(mcm_ui)
end

-- Wipes builtin overrides and custom category rows, so load_categories()
-- falls back to default_categories for everything. Mods assigned to a custom category
-- (value >= 1000) that no longer exists after the wipe fall back to
-- Uncategorized; builtin category values (0-14) stay valid either way.
restore_default_categories_action = function(mcm_ui)
	dbg_log("restore_default_categories_action fired")
	local config = get_cmc_config()
	if config:section_exist(CAT_CONFIG_SECTION) then
		local sec = config:collect_section(CAT_CONFIG_SECTION)
		for key, _ in pairs(sec) do
			config:remove_line(CAT_CONFIG_SECTION, key)
		end
	end
	remove_section_lines(config, CUSTOM_CAT_CONFIG_SECTION)
	if config:section_exist(CONFIG_SECTION) then
		local sec = config:collect_section(CONFIG_SECTION)
		for mod_id, assigned_val in pairs(sec) do
			local val = tonumber(assigned_val)
			if val and val >= 1000 then
				config:w_value(CONFIG_SECTION, mod_id, tostring(UNCATEGORIZED_VALUE))
			end
		end
	end
	config:save()
	dbg_log("  restore_default_categories_action: cleared category storage, reassigned mods on removed custom categories to Uncategorized")
	load_categories()
	if ui_mcm and ui_mcm.options then
		refresh_assignments(ui_mcm.options)
	end
	rebuild_manage_group()
	exit_to_main_tree(mcm_ui)
end

function organizer_path()
	return MCM_ID .. "/" .. CMC_ID
end

function page_selector(path)
	local group_id = type(path) == "string" and path:match("^([^/]+)")
	if not group_id or group_id == MCM_ID then
		return
	end
	dbg_log("page_selector('%s') -> group_id='%s'", tostring(path), group_id)
	return {
		id = assignment_option_id(group_id),
		type = "list",
		val = 2,
		def = { get_default_assignment, group_id },
		content = { category_options },
		no_str = true,
		hint = "ui_mcm_elseform_cmc_page_category",
		caption = "ui_mcm_elseform_cmc_page_category",
		curr = { get_assignment, group_id },
		functor = { set_assignment, group_id },
	}
end

function refresh_assignments(groups)
	dbg_log("refresh_assignments() start for %d groups", #groups)
	for i = 1, #groups do
		local group = groups[i]
		if group.id == MCM_ID then
			group._elseform_cmc_pinned = true
			group._elseform_cmc_category = nil
		else
			group._elseform_cmc_category = read_assignment(group.id).id
		end
	end
	if config_dirty then
		get_cmc_config():save()
		config_dirty = false
		dbg_log("  saved dirty config in refresh_assignments")
	end
	dbg_log("refresh_assignments() done")
end

function build_organizer(groups)
	dbg_log("build_organizer() start with %d groups", #groups)
	load_categories()
	refresh_assignments(groups)
	local assignments = {}
	local mcm_group = nil
	for i = 1, #groups do
		local group = groups[i]
		if group.id == MCM_ID then
			mcm_group = group
		else
			assignments[#assignments + 1] = {
				id = assignment_option_id(group.id),
				type = "list",
				val = 2,
				def = { get_default_assignment, group.id },
				content = { category_options },
				no_str = true,
				caption = organizer_caption(group),
				curr = { get_assignment, group.id },
				functor = { set_assignment, group.id },
			}
		end
	end
	table.sort(assignments, function(a, b)
		return a.caption:lower() < b.caption:lower()
	end)

	local rows = {
		{
			id = "title",
			type = "title",
			text = "ui_mcm_elseform_cmc_title",
		},
		{
			id = "description",
			type = "desc",
			text = "ui_mcm_elseform_cmc_desc",
		},
	}
	-- NOTE: for type="button" rows, Register_Button (ui_mcm.script) always
	-- prefixes `hint` with "ui_mcm_" itself to resolve the caption string.
	-- Unlike check/input/list rows (Register_Cap, which detects an existing
	-- "ui_mcm_" prefix and skips re-adding it), a button's hint must stay
	-- BARE here or the lookup double-prefixes and misses the string table.
	local clear_all_button = {
		id = "clear_all",
		type = "button",
		hint = "elseform_cmc_clear_all",
	}
	clear_all_button.functor_ui = {
		function(mcm_ui)
			dbg_log("clear_all button clicked!")
			stage_clear_all(assignments, mcm_ui)
		end,
	}
	for i = 1, #assignments do
		rows[#rows + 1] = assignments[i]
	end
	rows[#rows + 1] = { id = "actions_separator", type = "line" }
	rows[#rows + 1] = { id = "clear_all_notice", type = "desc", text = "ui_mcm_elseform_cmc_clear_all_notice", clr = {255, 200, 80, 80} }
	rows[#rows + 1] = clear_all_button
	rows[#rows + 1] = { id = "bottom_separator", type = "line" }

	if not mcm_group then
		dbg_log("build_organizer() warning: mcm_group not found!")
		return
	end
	
	mcm_group.gr[#mcm_group.gr + 1] = {
		id = CMC_ID,
		text = "ui_mcm_menu_elseform_cmc",
		sh = true,
		gr = rows,
		clr = { 255, 80, 200, 100 }, -- green
	}
	
	manage_group_ref = {
		id = "elseform_cmc_manage",
		text = "ui_mcm_menu_elseform_cmc_manage",
		sh = true,
		gr = {},
		clr = { 255, 80, 200, 100 }, -- green
	}
	rebuild_manage_group()
	mcm_group.gr[#mcm_group.gr + 1] = manage_group_ref
	dbg_log("build_organizer() complete")
end

function category_menu(groups)
	dbg_log("category_menu() start with %d groups", #groups)
	local counts = {}
	local mcm_group = nil
	local total = 0
	for i = 1, #groups do
		local group = groups[i]
		if group._elseform_cmc_pinned then
			mcm_group = group
		else
			local category = group._elseform_cmc_category or uncategorized_definition.id
			counts[category] = (counts[category] or 0) + 1
			total = total + 1
		end
	end
	
	local favorites_val = category_by_value[14] or default_categories[1]
	
	local result = {}
	if mcm_group then
		result[#result + 1] = mcm_group
	end
	
	result[#result + 1] = {
		id = "elseform_cmc_all_mods",
		text = "ui_mcm_elseform_cmc_category_all",
		_elseform_cmc_virtual_category = "all",
		_elseform_cmc_category_count = total,
		_elseform_cmc_root_color = { 255, 170, 185, 200 },
	}
	
	result[#result + 1] = {
		id = "elseform_cmc_category_" .. favorites_val.id,
		text = get_cat_display_name(favorites_val),
		_elseform_cmc_virtual_category = favorites_val.id,
		_elseform_cmc_category_count = counts[favorites_val.id] or 0,
		_elseform_cmc_root_color = { 255, 255, 191, 0 },
	}
	
	local pinned_items = {}
	local unpinned_items = {}
	
	local all_cats = {}
	for i = 1, #loaded_categories do
		all_cats[#all_cats + 1] = loaded_categories[i]
	end
	
	local sort_dxml = get_force_english_mcm()
	dbg_log("  sorting categories (dxml_alpha=%s)", tostring(sort_dxml))
	if sort_dxml then
		table.sort(all_cats, function(a, b)
			local name_a = get_cat_display_name(a):lower()
			local name_b = get_cat_display_name(b):lower()
			if name_a == name_b then
				return a.id < b.id
			end
			return name_a < name_b
		end)
	else
		table.sort(all_cats, function(a, b)
			return a.orig_order < b.orig_order
		end)
	end
	
	for i = 1, #all_cats do
		local cat = all_cats[i]
		if cat.id ~= "favorites" and not cat.deleted then
			local count = counts[cat.id] or 0
			if count > 0 then
				local item = {
					id = "elseform_cmc_category_" .. cat.id,
					text = get_cat_display_name(cat),
					_elseform_cmc_virtual_category = cat.id,
					_elseform_cmc_category_count = count,
				}
				if cat.pinned then
					pinned_items[#pinned_items + 1] = item
				else
					unpinned_items[#unpinned_items + 1] = item
				end
				dbg_log("  cat '%s' (pinned=%s) count=%d", cat.id, tostring(cat.pinned), count)
			end
		end
	end
	
	for i = 1, #pinned_items do
		result[#result + 1] = pinned_items[i]
	end
	
	for i = 1, #unpinned_items do
		result[#result + 1] = unpinned_items[i]
	end
	
	if (counts[uncategorized_definition.id] or 0) > 0 then
		result[#result + 1] = {
			id = "elseform_cmc_category_" .. uncategorized_definition.id,
			text = uncategorized_definition.text,
			_elseform_cmc_virtual_category = uncategorized_definition.id,
			_elseform_cmc_category_count = counts[uncategorized_definition.id],
			_elseform_cmc_root_color = { 255, 115, 170, 185 },
		}
		dbg_log("  cat 'uncategorized' count=%d", counts[uncategorized_definition.id])
	end
	
	dbg_log("category_menu() returning %d root menu entries", #result)
	return result
end

function filtered_menu(groups, category, include_pinned)
	dbg_log("filtered_menu(category='%s', include_pinned=%s) from %d groups", tostring(category), tostring(include_pinned), #groups)
	local result = {
		{
			id = "elseform_cmc_category_back",
			text = "ui_mcm_elseform_cmc_category_back",
			_elseform_cmc_category_back = true,
		},
	}
	for i = 1, #groups do
		local group = groups[i]
		local group_category = group._elseform_cmc_category or uncategorized_definition.id
		if (include_pinned or not group._elseform_cmc_pinned) and (category == "all" or group_category == category) then
			result[#result + 1] = group
		end
	end
	dbg_log("filtered_menu() returning %d filtered groups", #result)
	return result
end

local function on_mcm_apply()
	dbg_log("on_mcm_apply() callback fired. committing staged category (if any) and reloading")
	commit_staged_custom_edits()
	if draft_new_name ~= "" then
		load_categories()
	end
	commit_staged_category()
	draft_new_name = ""
	draft_new_pinned = false
	load_categories()
	if ui_mcm and ui_mcm.options then
		refresh_assignments(ui_mcm.options)
	end
	rebuild_manage_group()
end

local function on_mcm_discard()
	dbg_log("on_mcm_discard() callback fired. discarding staged category and reloading")
	draft_new_name = ""
	draft_new_pinned = false
	pending_custom_edits = {}
	load_categories()
	if ui_mcm and ui_mcm.options then
		refresh_assignments(ui_mcm.options)
	end
	rebuild_manage_group()
end

-- Registered here at module load, not inside on_game_start(): that hook is
-- driven by axr_main.script scanning every *.script file and calling
-- <name>.on_game_start() once per session -- confirmed via the flat-install
-- log to fire only once, well after the MCM menu is already reachable from
-- the main menu, and it silently never reaches later scripts in the scan if
-- an earlier one throws (also observed in the same log, from an unrelated
-- mod). RegisterScriptCallback/AddScriptCallback are native engine functions
-- (not defined in any .script file), so calling them unconditionally at
-- top level is safe and matches how ui_mcm.script itself registers its own
-- callbacks (AddScriptCallback calls at its own module scope).
RegisterScriptCallback("mcm_option_change", on_mcm_apply)
RegisterScriptCallback("mcm_option_discard", on_mcm_discard)
RegisterScriptCallback("mcm_option_reset", on_mcm_discard)
RegisterScriptCallback("mcm_option_restore_default", on_mcm_apply)
