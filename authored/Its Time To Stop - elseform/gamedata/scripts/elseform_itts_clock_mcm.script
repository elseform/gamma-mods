-- It's Time To Stop (ITTS) - real-time HUD clock MCM page

function on_mcm_load()
    local shared = elseform_itts_mcm
    local def = shared.DEF.clock
    local op = {
        id = "clock",
        sh = true,
        text = "ui_mcm_menu_itts_clock",
        gr = {
            shared.title(),
            {
                id = "clock_enabled", type = "check", val = 1,
                def = def.clock_enabled, hint = "itts_stat_clock_enabled",
            },
            {
                id = "clock_pos", type = "list", val = 0,
                def = def.clock_pos, hint = "itts_stat_clock_pos",
                content = {
                    { "compass_al", "itts_clock_pos_compass_al" },
                    { "p2", "itts_clock_pos_compass_ar" },
                    { "compass_bl", "itts_clock_pos_compass_bl" },
                    { "p1", "itts_clock_pos_compass_br" },
                    { "replace", "itts_clock_pos_compass_br_replace" },
                    { "tl", "itts_clock_pos_screen_tl" },
                    { "tr", "itts_clock_pos_screen_tr" },
                    { "bl", "itts_clock_pos_screen_bl" },
                    { "br", "itts_clock_pos_screen_br" },
                },
            },
            {
                id = "clock_font", type = "list", val = 0,
                def = def.clock_font, hint = "itts_stat_clock_font",
                content = {
                    { "letterica16", "itts_font_letterica16" },
                    { "letterica18", "itts_font_letterica18" },
                    { "letterica25", "itts_font_letterica25" },
                    { "graffiti19", "itts_font_graffiti19" },
                    { "graffiti22", "itts_font_graffiti22" },
                },
            },
            {
                id = "clock_clr", type = "list", val = 0,
                def = def.clock_clr, hint = "itts_stat_clock_clr",
                content = shared.CLR_CONTENT,
            },
            { id = "divider", type = "line" },
            {
                id = "clock_24h", type = "check", val = 1,
                def = def.clock_24h, hint = "itts_stat_clock_24h",
            },
            {
                id = "clock_blink", type = "check", val = 1,
                def = def.clock_blink, hint = "itts_stat_clock_blink",
            },
            { id = "divider1", type = "line" },
            {
                id = "clock_off_x", type = "track", val = 2,
                min = -200, max = 200, step = 5,
                def = def.clock_off_x, hint = "itts_stat_clock_off_x",
            },
            {
                id = "clock_off_y", type = "track", val = 2,
                min = -200, max = 200, step = 5,
                def = def.clock_off_y, hint = "itts_stat_clock_off_y",
            },
            { id = "divider2", type = "line" },
            {
                id = "clock_custom", type = "check", val = 1,
                def = def.clock_custom, hint = "itts_stat_clock_custom",
            },
            {
                id = "clock_r", type = "track", val = 2,
                min = 0, max = 255, step = 5,
                def = def.clock_r, hint = "itts_stat_clock_r",
            },
            {
                id = "clock_g", type = "track", val = 2,
                min = 0, max = 255, step = 5,
                def = def.clock_g, hint = "itts_stat_clock_g",
            },
            {
                id = "clock_b", type = "track", val = 2,
                min = 0, max = 255, step = 5,
                def = def.clock_b, hint = "itts_stat_clock_b",
            },
        },
    }
    return op, "elseform_itts"
end
